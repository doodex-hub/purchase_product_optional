<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.purchase.product.configurator</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- 20.0: product_id / product_template_id now live inside
                 <column name="product_and_description">, so `//list/field` no longer matches. -->
            <xpath expr="//list//field[@name='product_template_id']" position="attributes">
                <attribute name="column_invisible">0</attribute>
            </xpath>
            <!-- Hidden helper fields stay direct children of the list, after the column (a <column>
                 renders every child field in its single cell and ignores column_invisible). -->
            <xpath expr="//list/column[@name='product_and_description']" position="after">
                <field name="product_template_attribute_value_ids" column_invisible="1" />
                <field name="product_custom_attribute_value_ids" column_invisible="1" >
                    <list>
                        <field name="custom_product_template_attribute_value_id" />
                        <field name="custom_value" />
                    </list>
                </field>
                <field name="product_no_variant_attribute_value_ids" column_invisible="1" />
                <field name="is_configurable_product" column_invisible="1" />
            </xpath>
            <xpath expr="//list//field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="string">Product Variant</attribute>
            </xpath>
        </field>
    </record>

</odoo>
